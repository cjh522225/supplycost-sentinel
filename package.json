{
  "name": "supplycost-sentinel",
  "version": "1.0.0",
  "description": "供应链成本监测与动态调价预警智能体",
  "main": "./out/main/index.js",
  "author": "坏了坏了这下好了",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:local": "set SUPPLYCOST_DISABLE_SCHEDULER=1&& electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder --win nsis",
    "package:dir": "npm run build && electron-builder --win dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "backfill": "tsx scripts/backfill.ts",
    "verify": "python scripts/verify.py",
    "qa:evidence": "tsx scripts/qa-evidence.ts",
    "qa:samples": "tsx scripts/qa-samples.ts",
    "qa:rotation": "tsx scripts/qa-rotation.ts",
    "provenance": "tsx scripts/provenance.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "report": "tsx scripts/generate-report.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "docx": "^9.14.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright": "^1.64.1",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
